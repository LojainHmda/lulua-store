# Firebase project config (Project settings -> General -> Your apps -> SDK setup and config).
# These values are safe to expose in client code -- real security comes from
# Firestore/Storage security rules, not from hiding this config.
#
# Copy this file to .env.local and fill in your values, then restart `npm run dev`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" (as a shell/process env var when you start `npm run dev`,
# not committed here) to point this same project id at the local
# Firestore/Auth emulators (127.0.0.1:8080 / 127.0.0.1:9099) instead of the
# real backend -- see TESTING.md. Leave unset for normal development, which
# always talks to the real project above.
VITE_USE_FIREBASE_EMULATORS=

# Delivery company (Olivery, serving client "UnitedExp") Create Order
# integration -- see src/firebase/deliveryOrderConfig.ts.
#
# 2026-09-30: this is a dedicated Cloud Run service in this same GCP project
# (sisely-e7223, region us-central1). This app never holds the real United
# login/password AT ALL -- they live only in that service's Secret Manager
# secret. This is just the proxy's base URL, not a credential: every request
# to it is authenticated with the caller's own real Firebase ID token (see
# OrderDetail.tsx/deliveryOrder.ts), verified server-side against this app's
# own `admins/{uid}` collection -- not a static frontend secret.
VITE_UNITED_PROXY_URL=
